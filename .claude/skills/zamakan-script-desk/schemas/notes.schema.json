{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://zamakan.agency/schemas/script-notes/1",
 "title": "Script reader notes (written by Claude, read by annotate.py and report.py)",
 "type": "object",
 "required": ["schema", "lang", "logline_read", "overall", "lenses", "notes", "next_draft"],
 "additionalProperties": false,
 "properties": {
  "schema": {"const": "zamakan-script-notes/1"},
  "lang": {"enum": ["ar", "en"], "description": "language of the notes (default: the script's)"},
  "structure": {"type": "string", "description": "structure id the draft was read against (references/structures.json)"},
  "kind": {"enum": ["short", "feature"]},
  "logline_read": {"type": "string", "description": "the story in one line as the reader understood it; lets the writer see if it lands"},
  "overall": {"type": "object", "required": ["verdict", "summary"], "additionalProperties": false,
   "properties": {"verdict": {"enum": ["green", "amber", "red"]}, "summary": {"type": "string"}}},
  "lenses": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["id", "verdict", "summary"], "additionalProperties": false,
   "properties": {"id": {"type": "string"}, "verdict": {"enum": ["green", "amber", "red"]}, "summary": {"type": "string"},
    "strengths": {"type": "array", "items": {"type": "string"}}}}},
  "notes": {"type": "array", "items": {"type": "object", "required": ["scene", "lens", "kind", "text"], "additionalProperties": false,
   "properties": {"scene": {"type": "integer", "minimum": 1}, "lens": {"type": "string"},
    "kind": {"enum": ["issue", "question", "strength"]},
    "text": {"type": "string", "description": "the note: what you saw and a question for the writer; never a rewrite of their lines"},
    "quote": {"type": "string", "description": "exact words from that scene to anchor the comment (optional)"}}}},
  "questions_for_writer": {"type": "array", "items": {"type": "string"}},
  "next_draft": {"type": "array", "minItems": 1, "maxItems": 5, "items": {"type": "string"}, "description": "the top priorities, in order"}
 }
}
